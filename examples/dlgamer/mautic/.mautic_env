# use this file for environment variables that can be used.
# see https://docs.mautic.org/en/5.x/

MAUTIC_DB_HOST="${MYSQL_HOST}"
MAUTIC_DB_PORT="${MYSQL_PORT}"
MAUTIC_DB_DATABASE="${MYSQL_DATABASE}"
MAUTIC_DB_USER="${MYSQL_USER}"
MAUTIC_DB_PASSWORD="${MYSQL_PASSWORD}"
MAUTIC_CONFIG_DEBUG=1
PHP_INI_VALUE_MEMORY_LIMIT=2G
PHP_INI_VALUE_MAX_EXECUTION_TIME=3600
PHP_INI_VALUE_LOG_ERRORS=On
PHP_INI_VALUE_ERROR_LOG=/dev/stdout
DOCKER_MAUTIC_LOAD_TEST_DATA=False

# Set to true to overwrite /opt/mautic/cron/mautic from the baked-in template
# on the next mautic_cron container start. Use after the image's cron template
# has been updated and you want existing deployments to adopt the new schedule.
# Remember to set back to false (or unset) afterwards to preserve local edits.
#DOCKER_MAUTIC_RESET_CRON=false

# Messenger DSNs live in /portainer/${COMPOSE_PROJECT_NAME}-mautic/config/local.php
# Local.php file should be set manually
# mautic stats in install mode as long as no domain name is set
